azure_subscription_id = "cc1ccb8d-18a1-4dca-aa5a-54607876c990" # IGMF sandbox subscription
location              = "uksouth"
environment           = "igmf"
subscription_code     = "vdi"

# Paste from igmf/connectivity outputs after apply
hub01_id                  = "/subscriptions/cc1ccb8d-18a1-4dca-aa5a-54607876c990/resourceGroups/uks-conn-rsg-connectivity/providers/Microsoft.Network/virtualHubs/uks-conn-vhb-hub01"
hub02_id                  = "/subscriptions/cc1ccb8d-18a1-4dca-aa5a-54607876c990/resourceGroups/uks-conn-rsg-connectivity/providers/Microsoft.Network/virtualHubs/uks-conn-vhb-hub02"
hub01_firewall_private_ip = "10.170.245.132" # TODO(deploy): connectivity output hub01_firewall_private_ip

mandatory_tags = {
  costCentre             = "IGMF-SANDBOX"
  securityClassification = "Limited"
  resourceOwner          = "dan.bowen@ignitemyfire.co.uk"
  CMDB_AppID             = "IGMF001"
}

dns_servers = ["168.63.129.16"] # Azure DNS — do NOT use bank 10.19.*

# Thin sandbox defaults — spokes + lab KVs still deploy; skip FSLogix/blob pain
enable_fslogix     = false
enable_pers_blob   = true
# enable_lab_keyvaults = true  # default; set false to skip Premium KVs

