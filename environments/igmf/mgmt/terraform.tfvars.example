azure_subscription_id = "cc1ccb8d-18a1-4dca-aa5a-54607876c990" # IGMF sandbox subscription
location              = "uksouth"
environment           = "igmf"
subscription_code     = "mgmt"

# Paste from igmf/connectivity outputs after apply
hub01_id                  = "/subscriptions/REPLACE/resourceGroups/REPLACE/providers/Microsoft.Network/virtualHubs/REPLACE"
hub01_firewall_private_ip = "10.0.0.0" # TODO(deploy): connectivity output hub01_firewall_private_ip

mandatory_tags = {
  costCentre             = "IGMF-SANDBOX"
  securityClassification = "Limited"
  resourceOwner          = "dan.bowen@ignitemyfire.co.uk"
  CMDB_AppID             = "IGMF001"
}

# Reuse int mgmt CIDR — fine in isolated tenant
mgmt_address_space = ["10.170.139.192/26"]
dns_servers        = ["168.63.129.16"] # Azure DNS — do NOT use bank 10.19.*

alert_action_group_email = "dan.bowen@ignitemyfire.co.uk"

# REQUIRED — bank default SP must not be used in IGMF
devops_vm_contributor_principal_id = null

# Leave empty for sandbox unless you scope alerts later
