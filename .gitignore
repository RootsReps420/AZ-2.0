# Terraform working directories & provider binaries (large, machine-local)
**/.terraform/*

# State files — never commit; may contain secrets
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files that may hold secrets
*.tfvars
*.tfvars.json
!example.tfvars
# Regional env×stack value files are committed config (placeholders / non-secret)
!environments/region/**/*.tfvars

# CLI config / plan output
.terraformrc
terraform.rc
*.tfplan

# Keep the dependency lock file (.terraform.lock.hcl) tracked.

# Local reference copy of Azure 1.0 repos (not deployed; Privacy Mode / large)
legacy/

# Local-only docs (handoff, sandbox runbooks — keep on disk, do not push)
docs/plans/03-cursor-handoff.md
docs/plans/05-sandbox-deploy-runthrough.md
